# Caddy reverse proxy configuration for PRODUCTION
# This file enables automatic HTTPS via Let's Encrypt for crickzen.com
# IMPORTANT: Ensure DNS A records for crickzen.com and www.crickzen.com 
#            point to this server's public IP before deploying

{
  # Global ACME email for Let's Encrypt notifications
  email {$EMAIL}
  
  # Uncomment below to use Let's Encrypt staging (avoid rate limits during testing):
  # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
  
  # Uncomment for verbose logging:
  # debug
}

# Production domain configuration with automatic HTTPS
crickzen.com, www.crickzen.com {
  encode zstd gzip
  
  # SEO endpoints - proxy to backend
  # These are critical for search engine indexing
  @seo {
    path /sitemap.xml /sitemaps/* /robots.txt
  }
  handle @seo {
    reverse_proxy backend:8099 {
      header_up Host {host}
      header_up X-Real-IP {remote}
    }
  }

  # API routes that already exist on backend with the /api prefix.
  @backend_api_passthrough {
    path /api/v1/* /api/poll/* /actuator/* /h2-console* /swagger-ui* /swagger-ui.html /v3/api-docs*
  }
  handle @backend_api_passthrough {
    reverse_proxy backend:8099 {
      header_up Host {host}
      header_up X-Real-IP {remote}
    }
  }

  # Legacy frontend API calls still use the /api prefix even though backend
  # controllers are mounted at /cricket-data, /events, /tennis, /market, /ws,
  # and /token. Strip /api before proxying to backend.
  @legacy_api {
    path /api/* /token/*
  }
  handle @legacy_api {
    uri strip_prefix /api
    reverse_proxy backend:8099 {
      header_up Host {host}
      header_up X-Real-IP {remote}
      flush_interval -1
    }
  }
  
  # Serve frontend Angular app proxied from internal container
  # Nginx inside frontend container handles static asset and SPA routing.
  handle {
    reverse_proxy frontend:80 {
      header_up Host {host}
      header_up X-Real-IP {remote}
    }
  }

  # Optional: health endpoint
  @health path /health /healthz
  respond @health "ok" 200

  # Production security headers
  header {
    # HSTS with preload for 1 year
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # CSP allowing WebSocket connections (wss: for production)
    Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: https:; connect-src 'self' wss: https:;"
  }
  
  # Log successful requests (errors are logged by default)
  log {
    output file /data/access.log
    format json
  }
}

# Optional: Redirect www to non-www (or vice versa)
# Uncomment if you prefer non-www as canonical:
# www.crickzen.com {
#   redir https://crickzen.com{uri} permanent
# }

# ─── betx21exch.live betting app ────────────────────────
# Proxies to the betx21exch Express backend running on the host (port 3001)
# and to the betx21 Caddy (port 8088) for frontend static files.
# 172.18.0.1 is the Docker bridge gateway to the host.

betx21exch.live {
  encode zstd gzip

  # API routes → Express backend directly
  handle /api/* {
    reverse_proxy 172.18.0.1:3001 {
      header_up Host {host}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-Proto {scheme}
      transport http {
        read_timeout 300s
        write_timeout 300s
      }
    }
  }

  # Socket.IO → Express backend directly (WebSocket upgrade is automatic)
  handle /socket.io/* {
    reverse_proxy 172.18.0.1:3001 {
      header_up Host {host}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-Proto {scheme}
      transport http {
        read_timeout 86400s
        write_timeout 86400s
      }
    }
  }

  # Frontend SPA → betx21 Caddy on 8088 (serves static files + SPA fallback)
  handle {
    reverse_proxy 172.18.0.1:8088 {
      header_up Host {host}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  # Security headers
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  log {
    output file /data/betx21-access.log
    format json
  }
}

# cricket_ledger direct IP access
http://204.12.199.137 {
  reverse_proxy 172.18.0.1:3010 {
    header_up Host {host}
    header_up X-Real-IP {remote}
    header_up X-Forwarded-Proto {scheme}
  }

  log {
    output file /data/cricket-ledger-ip-access.log
    format json
  }
}

# --- CrickZen dashboard ---
app.crickzen.com {
  encode zstd gzip

  # Telegram operator UI (Streamlit, host port 8502)
  handle /telegram* {
    reverse_proxy 172.18.0.1:8502 {
      header_up Host {host}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  handle {
    reverse_proxy crickzen-dashboard:8000 {
      header_up Host {host}
      header_up X-Real-IP {remote}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
  }

  log {
    output file /data/app-crickzen-access.log
    format json
  }
}
