# ====================================
# VictoryLine Production Docker Environment
# ====================================
# Copy this file to .env before running docker-compose.prod.yml
# Update secrets (passwords, tokens, URLs) before deploying to production

# ====================================
# Docker Images
# v1.0.0 - SEO Optimization Release
# v1.0.1 - Live Match Glance UI Enhancements (Responsive Design, Chase Summary, Current Ball)
# v1.1.0 - Scraper Resilience (Automatic Restart, Memory Limits, Monitoring)
# v1.1.2 - Periodic Container Restart (fixes thread/PID leak)
# v1.1.3 - localStorage Timing Fix (complete player data extraction, 100% scorecard coverage)
# v1.1.4 - Scraper Resilience Fix (PID limit increase, process cleanup, staleness threshold adjustment)
# v1.2.1 - Timeout Fix & Live Match Filtering (BACKEND_TIMEOUT 30s, finished match exclusion, PID limit removed)
# v1.2.2 - Upcoming fixture team names + production rollout alignment
# Keep BACKEND/FRONTEND/SCRAPER/PRERENDER pins on the same release tag family or the same commit-based incident build.
# For incident hotfix tracking, use commit-based tags such as victoryline-scraper:healthfix-<sha>.
# ====================================
MYSQL_IMAGE=mysql:8.0
BACKEND_IMAGE=macubex/victoryline-backend:v1.2.2
FRONTEND_IMAGE=macubex/victoryline-frontend:v1.2.2
SCRAPER_IMAGE=macubex/victoryline-scraper:v1.2.2
PRERENDER_IMAGE=macubex/victoryline-prerender:v1.2.2

# ====================================
# MySQL Database Configuration (COMMENTED OUT - Using H2 instead)
# ====================================
# MYSQL_ROOT_PASSWORD=VictoryLine2025!Root@MySQL
# MYSQL_DATABASE=cricket_db
# MYSQL_USER=cricket_user
# MYSQL_PASSWORD=Cricket2025!User@Pass
# MYSQL_PORT=3306

# ====================================
# Backend (Spring Boot) Configuration
# ====================================
BACKEND_PORT=8099
SPRING_PROFILES_ACTIVE=prod
# Using H2 Embedded Database
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:h2:file:/app/data/victoryline;DB_CLOSE_ON_EXIT=FALSE
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_H2_CONSOLE_ENABLED=true
SPRING_H2_CONSOLE_PATH=/h2-console
SHOW_SQL=false

# JWT Configuration
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRATION=86400

SCRAPER_HYDRATE_URL=http://scraper:5000/hydrate-match-details

# SEO / Google Search Console / Indexing
GSC_ENABLED=true
GSC_SITE_URL=https://www.crickzen.com/
GSC_SITEMAP_URL=https://www.crickzen.com/sitemap.xml
SEO_PRIORITY_MATCH_COUNT=5
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=https://www.crickzen.com/indexnow-key.txt
GSC_SERVICE_ACCOUNT_FILE=./gsc-service-account.json
GSC_SERVICE_ACCOUNT_PATH=/app/config/gsc-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/app/config/gsc-service-account.json
INDEXING_SCHEDULER_ENABLED=true
INDEXING_SCHEDULER_INTERVAL_MS=900000
INDEXING_MAX_PER_RUN=10

# RapidAPI Configuration (Cricket News)
RAPIDAPI_KEY=your_rapidapi_key

# ====================================
# Frontend (Angular) Configuration
# ====================================
FRONTEND_PORT=4007
NODE_VERSION=16.20.2
API_URL=http://backend:8099

# ====================================
# Scraper (Python Flask) Configuration
# ====================================
SCRAPER_PORT=5000
BACKEND_URL=http://backend:8099
TOKEN_URL=http://backend:8099/token/generate-token
SERVICE_URL=http://backend:8099/cricket-data
ADD_LIVE_MATCHES_URL=http://backend:8099/cricket-data/add-live-matches
SYNC_SCHEDULE_MATCHES_URL=http://backend:8099/cricket-data/sync-schedule-matches
API_ENDPOINT=http://backend:8099/cricket-data/match-info/save
API_ENDPOINT_SC4=http://backend:8099/cricket-data/sC4-stats/save
REDIS_URL=redis://redis:6379/0
FLASK_ENV=production
FLASK_DEBUG=0
PLAYWRIGHT_HEADLESS=true

# Resilience Features (004-scraper-resilience)
SCRAPER_MAX_LIFETIME_HOURS=6
MEMORY_SOFT_LIMIT_MB=1536
MEMORY_HARD_LIMIT_MB=2048
POLLING_INTERVAL_SECONDS=0.8
POLLING_MIN_SECONDS=2
POLLING_BREAK_SECONDS=30
PAGE_TIMEOUT_SECONDS=30
ENABLE_PROMETHEUS_METRICS=true
PROMETHEUS_PORT=9090
STALENESS_THRESHOLD_SECONDS=300
PID_SOFT_LIMIT=360
PID_RESTART_THRESHOLD=500
ENABLE_FAST_UPDATES=false
# Fast Updates Features (007-fast-updates)
ENABLE_PERSISTENT_PAGES=false
PERSISTENT_PAGE_MAX_COUNT=30
PERSISTENT_PAGE_MAX_AGE_SECONDS=7200
FAST_POLL_INTERVAL_MS=1000

# ====================================
# Prerender Service Configuration
# ====================================
PRERENDER_PORT=9100

# ====================================
# Monitoring Configuration
# ====================================
PROMETHEUS_UI_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_ROOT_URL=https://grafana.crickzen.com

# ====================================
# Caddy Reverse Proxy Configuration
# ====================================
LETSENCRYPT_EMAIL=admin@example.com

# ====================================
# Docker Engine
# ====================================
# DOCKER_BUILDKIT=1
# COMPOSE_DOCKER_CLI_BUILD=1
